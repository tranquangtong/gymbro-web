// Dữ liệu đã chuyển sang Cloudflare D1 (gymbro-api).
// Firebase chỉ còn dùng cho đăng nhập Google.
// Firestore đã được xóa sạch ngày 2026-11-27.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
